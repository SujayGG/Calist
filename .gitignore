# Generated on every plan/serve/done/say. Tracking these guaranteed a merge
# conflict on every single `git pull`, which is exactly what happened. Rebuild
# them in one second with: calist plan
data/plan.json
data/plan.ics
data/state.json

# Activity logs - machine-local, can get noisy
data/log.jsonl
data/usage.jsonl

# Dropped syllabi and calendars
data/sources/*
!data/sources/.gitkeep

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
